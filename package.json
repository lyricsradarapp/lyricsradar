{
  "name": "lyricsradar",
  "version": "1.0.0",
  "description": "Lyrics search and parsing for Node.js: Apple-style TTML with word-sync, @braccato/parsers, and Genius.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./genius": {
      "types": "./dist/genius/index.d.ts",
      "import": "./dist/genius/index.mjs",
      "require": "./dist/genius/index.cjs"
    },
    "./ttml": {
      "types": "./dist/ttml/index.d.ts",
      "import": "./dist/ttml/index.mjs",
      "require": "./dist/ttml/index.cjs"
    },
    "./parsers": {
      "types": "./dist/parsers/index.d.ts",
      "import": "./dist/parsers/index.mjs",
      "require": "./dist/parsers/index.cjs"
    }
  },
  "files": [
    "dist",
    "prebuilds"
  ],
  "scripts": {
    "build": "tsup",
    "test": "node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lyrics",
    "ttml",
    "synced-lyrics",
    "genius",
    "genius-api",
    "lyrics-parser",
    "word-sync",
    "braccato"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@braccato/parsers": "^0.1.2",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
